generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Side {
  LONG
  SHORT
}

// Which leg of a pump the call was made on — optional, for record-keeping
// and later filtering only; never computed or validated against price action.
enum PumpPhase {
  SECOND_LEG_START // 2차 시작
  THIRD_LEG_START // 3차 시작
  ADDITIONAL_RISE // 추가 상승
  TOP_EXPECTED // 고점 예상
  TOP_REBOUND_THEN_DROP // 고점 반등 이후 하락
  REBOUND_THEN_DROP // 반등 이후 하락
  OTHER // 기타
}

// A single long/short call the user logged for a Binance futures alt.
// entryPrice is snapshotted at write time from Binance's futures kline
// covering entryTime, so later reads don't drift if history changes.
model LongShortEntry {
  id              String     @id @default(cuid())
  symbol          String // Binance futures symbol, e.g. "SUIUSDT"
  side            Side
  entryTime       DateTime
  entryPrice      Float
  // BTCUSDT futures price at entryTime — snapshotted the same way as
  // entryPrice, so BTC's own checkpoint metrics can be benchmarked alongside
  // this entry's. Nullable so older rows (and any failed lookup) stay valid;
  // the read path backfills it lazily on first load.
  btcPriceAtEntry Float?
  pumpPhase       PumpPhase?
  note            String?
  // Whether this was money actually put on the trade vs. a call logged only
  // to track a read on the market ("관점용"). Defaults true so existing rows
  // (all real trades except two backfilled exceptions) stay correct as-is.
  isRealTrade     Boolean    @default(true)
  // When set, this entry is considered closed as of this timestamp: its
  // checkpoint metrics stop advancing past endedAt instead of tracking the
  // live price.
  endedAt         DateTime?
  createdAt       DateTime   @default(now())
  // Daily-candle chart screenshot (Vercel Blob URL) auto-captured around
  // entryTime — the price context the call was made in, plus how it played
  // out afterward. Null until generated (see src/lib/chartSnapshot.ts).
  chartImageUrl   String?

  // Manually-linked real Binance position(s) synced from the account's own
  // trade history (see BinancePosition below). Optional, user-set — never
  // inferred automatically, so a wrong auto-match can't silently attach.
  binancePositions BinancePosition[]

  @@index([entryTime])
}

enum BinancePositionStatus {
  OPEN
  CLOSED
}

enum FillEventType {
  ENTRY // opened the position from flat
  ADD // increased an already-open position in the same direction
  PARTIAL_TP // reduced the position without flattening it
  CLOSE // reduced the position down to flat
}

// A real position on the user's Binance USDT-M Futures account, rebuilt by
// grouping consecutive same-symbol/same-direction fills (see
// src/lib/binancePositionEngine.ts). This is the "trade_id" anchor: its `id`
// is stable across incremental re-syncs, and it can optionally be linked to
// a manually-logged LongShortEntry via linkedLsEntryId. Read-only mirror of
// exchange data — nothing here is ever written back to Binance.
model BinancePosition {
  id     String                @id @default(cuid())
  symbol String
  side   Side // LONG or SHORT: the position's direction (Binance positionSide in hedge mode, or the inferred net direction in one-way mode)
  status BinancePositionStatus @default(OPEN)

  openedAt DateTime
  closedAt DateTime?

  // Weighted-average bookkeeping. avgEntryPrice = entryNotional / entryQty;
  // avgExitPrice = exitNotional / exitQty (0 while nothing has been closed
  // yet). Kept as running sums rather than a recomputed average so
  // incremental syncs can just add to them.
  entryQty      Float @default(0)
  entryNotional Float @default(0)
  exitQty       Float @default(0)
  exitNotional  Float @default(0)

  // Sum of Binance-reported realizedPnl / commission across every fill in
  // this position — the actual, exchange-computed trading result. Never
  // touched by post-close price tracking (see PostCloseObservation).
  realizedPnl     Float   @default(0)
  commission      Float   @default(0)
  commissionAsset String?

  // Best-effort snapshot of the symbol's leverage setting, taken the first
  // time this position is created. Binance does not expose historical
  // per-trade leverage, so this can be stale if the user changed leverage
  // mid-position before the first sync observed it.
  leverage Int?

  // Optional manual link to a hand-logged L/S Tracker call. Never inferred
  // automatically — set only through the UI.
  linkedLsEntryId String?
  linkedLsEntry   LongShortEntry? @relation(fields: [linkedLsEntryId], references: [id], onDelete: SetNull)

  fills        BinanceFill[]
  observations PostCloseObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol, status])
  @@index([openedAt])
}

// One raw execution/fill pulled from Binance Futures GET /fapi/v1/userTrades
// — one row per actual match, not per order. Pure read-only mirror of
// exchange data, kept even after grouping so the position math is always
// auditable back to source rows.
model BinanceFill {
  id             String @id @default(cuid())
  symbol         String
  binanceTradeId BigInt
  orderId        BigInt

  side         String // BUY | SELL, as reported by Binance
  positionSide String // LONG | SHORT | BOTH (BOTH = one-way mode)

  price    Float
  qty      Float
  quoteQty Float

  realizedPnl     Float
  commission      Float
  commissionAsset String
  isMaker         Boolean
  time            DateTime

  // Assigned by the grouping engine once this fill has been processed; null
  // briefly between ingestion and grouping.
  eventType  FillEventType?
  positionId String?
  position   BinancePosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([symbol, binanceTradeId])
  @@index([positionId])
  @@index([symbol, time])
}

// Price snapshots taken AFTER a position closed, at the same 3d/7d/14d/30d
// checkpoints the manual L/S Tracker uses. Deliberately a separate table
// from BinancePosition's realizedPnl/commission so "what the price did
// afterward" can never leak into or be confused with actual trading
// performance.
model PostCloseObservation {
  id         String          @id @default(cuid())
  positionId String
  position   BinancePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  checkpoint String // "3d" | "7d" | "14d" | "30d"
  observedAt DateTime
  price      Float
  // Directional return vs. the position's avgExitPrice — how the price
  // moved after the user actually got out, not a trading result.
  returnPct  Float

  createdAt DateTime @default(now())

  @@unique([positionId, checkpoint])
}

// Per-symbol pagination cursor for incremental Binance userTrades sync —
// lets each sync run resume from the last processed trade id instead of
// re-fetching full history.
model BinanceSyncCursor {
  symbol       String    @id
  lastTradeId  BigInt    @default(0)
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

// Singleton bookkeeping row (id is always 1) for the sync job itself — last
// run time/status, and a simple lock so overlapping manual + cron triggers
// don't hammer Binance's rate limits at the same time.
model BinanceSyncMeta {
  id            Int       @id @default(1)
  lastRunAt     DateTime?
  lastRunStatus String? // "ok" | "error"
  lastError     String?
  updatedAt     DateTime  @updatedAt
}

// Shape of the overall rise judged visually by the researcher — how many
// distinct slope segments the run through H3 traces, and whether they're
// closer to straight lines, a smooth curve, or a mix.
enum ShapeType {
  LINEAR
  CURVE
  MIXED
}

// A single hand-labeled parabolic pump structure for chart research: the
// researcher marks the start low, three rise/pullback legs, the post-top
// drop, and the first rebound (plus an optional next drop) by time+price,
// and the app fills in each leg's Binance volume total and derived
// duration/%/slope/ratio metrics — a training-data row for later
// statistical/ML work on whether a 3rd leg forms after L2 and whether H3
// ends up being the final top. Always Binance USDT-M futures (matches the
// rest of the dashboard) — read-only price/volume data, nothing written back.
model ParabolicCase {
  id        String @id @default(cuid())
  symbol    String // Binance futures symbol, e.g. "ENAUSDT"
  exchange  String @default("binance") // stored explicitly for a future non-Binance source; every case today is Binance futures
  timeframe String // Kline interval the structure was read on, e.g. "1h", "4h"

  l0Time  DateTime // 전체 펌핑 시작 저점
  l0Price Float
  h1Time  DateTime // 1차 상승 고점
  h1Price Float
  l1Time  DateTime // 1차 조정 저점
  l1Price Float
  h2Time  DateTime // 2차 상승 고점
  h2Price Float
  l2Time  DateTime // 2차 조정 저점
  l2Price Float
  h3Time  DateTime // 3차 상승 고점
  h3Price Float
  l3Time  DateTime // H3 이후 첫 의미 있는 하락 저점
  l3Price Float
  r1Time  DateTime // L3 이후 첫 의미 있는 반등 고점
  r1Price Float
  l4Time  DateTime? // R1 이후 다음 하락 저점 — 아직 없으면 null
  l4Price Float?

  // Broader shape context, both optional and independent of the L0~L4
  // structure above — kept separate on purpose so a "4-stage" view (from
  // the true base, through the long consolidation) and a "3-stage" view
  // (from the actual breakout) of the same case can be compared later.
  baseLowTime         DateTime? // 긴 횡보 이전까지 포함한 전체 바닥
  baseLowPrice        Float?
  parabolicStartTime  DateTime? // 실제 가속 상승이 시작된 시점
  parabolicStartPrice Float?
  slopeCount          Int? // 눈으로 판단한 주요 기울기 개수
  shapeType           ShapeType?

  // Kline volume totals over each leg, summed server-side from Binance at
  // save time (see src/lib/parabolic.ts) — never entered manually.
  rise1Vol    Float // L0→H1
  drop1Vol    Float // H1→L1
  rise2Vol    Float // L1→H2
  drop2Vol    Float // H2→L2
  rise3Vol    Float // L2→H3
  postDropVol Float // H3→L3
  reboundVol  Float // L3→R1

  // Raw OHLCV candles (Binance futures, this case's timeframe) spanning
  // L0 through L4/R1, as compact [timestamp, open, high, low, close, volume]
  // tuples — kept alongside the leg volume totals so later
  // statistical/ML work has the full series, not just the aggregates.
  candles Json?

  // Snapshot of derived per-leg %/duration/slope and structure ratios,
  // computed once at save time from the points above (see
  // computeParabolicMetrics in src/lib/parabolic.ts). Kept as a snapshot —
  // like entryPrice elsewhere in this schema — so a later change to the
  // calculation doesn't silently reshape historical cases.
  metrics Json

  // Labels for later statistical/ML training — deliberately separate from
  // the computed `metrics` snapshot since these are judgment calls the
  // researcher can revise at any time (see the PATCH route), not derived
  // from the points. Null = not yet labeled.
  // L2 이후 의미 있는 3차 상승(H3)이 실제로 발생했다고 볼 수 있는지.
  thirdWaveOccurred Boolean?
  // H3가 최종 고점이면 true, 아니면 false.
  finalTopYn        Boolean?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol])
  @@index([l0Time])
}
